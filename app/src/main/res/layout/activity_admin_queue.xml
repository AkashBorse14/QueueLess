<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnQueueBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Live Queue Desk"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvAdminOfficeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Office Admin Desk"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQueueLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_token_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="LIVE DESK"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Currently Serving Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCurrentlyServing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="3dp"
        app:strokeColor="@color/status_serving"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="NOW SERVING AT DESK"
                android:textColor="@color/status_serving"
                android:textSize="12sp" />

            <!-- Large Serving Token -->
            <TextView
                android:id="@+id/tvDeskServingToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:text="None"
                android:textColor="@color/text_primary"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tvDeskServingCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Counter is ready for next customer"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Serving Actions Row (Completed & Skip) -->
            <LinearLayout
                android:id="@+id/layoutServingActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkCompleted"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/status_serving"
                    android:text="✓ Completed"
                    android:textSize="13sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkipCustomer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="✕ Skip Absent"
                    android:textColor="@color/status_cancelled"
                    android:textSize="13sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/status_cancelled" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Call Next Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCallNextCustomer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="▶ Call Next Customer"
        android:textSize="15sp"
        app:cornerRadius="@dimen/button_corner_radius" />

    <!-- Queue List Header with Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_small"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Waiting Customers in Queue"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminWaitingHeaderCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="0 Waiting"
            android:textColor="@color/status_waiting"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbAdminQueue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/spacing_large"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/containerEmptyQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_people_queue"
            app:tint="@color/text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:fontFamily="sans-serif-medium"
            android:text="The Queue is Empty"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="No customers are currently waiting."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- RecyclerView of Waiting Tokens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
